#!/usr/bin/env bash
# Writes <core>/Gemfile.td-dev: core's own Gemfile with the pinned
# placecal-theme-transdimension gem swapped for a path entry pointing at this
# checkout, so `bundle exec rspec` and `bundle exec rubocop` run against the
# working tree rather than the released tag.
#
# The generated file is local to the core checkout: do not commit it there
# (add it to core's .git/info/exclude).
#
# Usage:
#   bin/td-dev-gemfile [core-checkout] [engine-path-as-seen-from-core]
#
# Both arguments have defaults; PLACECAL_CORE_PATH is honoured for the first.
set -euo pipefail

core=${1:-${PLACECAL_CORE_PATH:-../PlaceCal}}
engine=${2:-../placecal-theme-transdimension}

if [ ! -f "$core/Gemfile" ]; then
	echo "No Gemfile at $core: pass the PlaceCal checkout as the first argument." >&2
	exit 1
fi

cat > "$core/Gemfile.td-dev" <<RUBY
# Generated by bin/td-dev-gemfile in the theme engine. Local only, do not commit.
# Core with the TD extension from a path checkout instead of the pinned git tag.
core = File.read(File.expand_path('Gemfile', __dir__))
core = core.sub(/^group :extensions do.*?^end\n/m, '')
instance_eval(core, File.expand_path('Gemfile', __dir__), 1)
gem 'placecal-theme-transdimension', path: '$engine'
RUBY

echo "Wrote $core/Gemfile.td-dev (engine path: $engine)"
